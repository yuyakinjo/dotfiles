# Homebrew Bundle file for this dotfiles setup.
# Install everything at once with: brew bundle --file=./Brewfile
# (bootstrap.sh runs this automatically after chezmoi apply)
#
# This file is kept in sync automatically: dot_zsh/functions/brew.zsh wraps the
# `brew` command so that `brew install` / `uninstall` / `reinstall` re-run
# `brew bundle dump --force` afterwards. No need to edit this file by hand.

brew "chezmoi"
brew "gh"
brew "starship"
brew "zoxide"
brew "fzf"

tap "Aloxaf/fzf-tab"
brew "fzf-tab"
